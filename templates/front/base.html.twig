<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Disable Turbo Drive so CDN-loaded scripts (Chart.js, Leaflet) always run -->
    <meta name="turbo-visit-control" content="reload">
    <title>{% block title %}AgriGo{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --front-forest: #2a5a3e;
            --front-olive: #4f6f39;
            --front-leaf: #87a95f;
            --front-cream: #f7f3e8;
            --front-ink: #1f2933;
            --front-muted: #5f6d68;
        }

        body {
            font-family: 'Source Sans 3', sans-serif;
            color: var(--front-ink);
            background:
                radial-gradient(1200px 520px at 8% -20%, #dce9d4 0%, transparent 60%),
                radial-gradient(1000px 460px at 100% -10%, #e7edd2 0%, transparent 58%),
                linear-gradient(180deg, #f9f7f0 0%, #eef3e4 100%);
            min-height: 100vh;
        }

        .front-nav {
            background: rgba(42, 90, 62, 0.92);
            backdrop-filter: blur(5px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .navbar-brand {
            font-family: 'DM Serif Display', serif;
            font-size: 1.65rem;
            letter-spacing: 0.3px;
        }

        .front-nav .nav-link {
            color: rgba(255, 255, 255, 0.88);
            font-weight: 600;
        }

        .front-nav .nav-link:hover {
            color: #ffffff;
        }

        .front-avatar-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            margin-left: 0.35rem;
        }

        .front-avatar-img,
        .front-avatar-fallback {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.6);
            object-fit: cover;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.18);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.86rem;
        }

        .front-hero {
            margin-top: 1.25rem;
            margin-bottom: 1.25rem;
            border-radius: 20px;
            overflow: hidden;
            background:
                linear-gradient(120deg, rgba(36, 72, 53, 0.95), rgba(83, 114, 62, 0.9)),
                url('https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=1600&q=80') center/cover;
            color: #f6f8f3;
            box-shadow: 0 20px 40px rgba(36, 63, 47, 0.18);
        }

        .front-hero-inner {
            padding: clamp(1.2rem, 2.4vw, 2rem);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .front-kicker {
            font-size: 0.82rem;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            opacity: 0.9;
            margin-bottom: 0.45rem;
        }

        .front-hero h1 {
            margin: 0;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.65rem, 4vw, 2.6rem);
            line-height: 1.05;
            max-width: 16ch;
        }

        .front-badges {
            display: flex;
            gap: 0.65rem;
            flex-wrap: wrap;
        }

        .front-badge {
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.24);
            padding: 0.5rem 0.9rem;
            border-radius: 999px;
            font-size: 0.9rem;
            backdrop-filter: blur(4px);
        }

        .front-shell {
            background: #fffefa;
            border: 1px solid #deead6;
            border-radius: 20px;
            box-shadow: 0 18px 44px rgba(58, 74, 48, 0.11);
            padding: clamp(1rem, 2.2vw, 1.8rem);
        }

        .front-shell .table thead th {
            background-color: #2f5b40;
            color: #f4f8f2;
            border-color: #395f4a;
        }

        .front-shell .btn-primary {
            background-color: var(--front-forest);
            border-color: var(--front-forest);
        }

        .front-shell .btn-primary:hover {
            background-color: #214b33;
            border-color: #214b33;
        }

        .front-shell .btn-outline-secondary {
            border-color: #7a8d7d;
            color: #3d5448;
        }

        .front-shell .btn-outline-secondary:hover {
            background: #eff4e9;
            color: #294534;
            border-color: #607567;
        }

        @media (max-width: 768px) {
            .front-hero-inner {
                align-items: flex-start;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark front-nav sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="{{ path('app_front_home') }}">Agrigo</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="{{ path('app_front_home') }}">Accueil</a>
            <a class="nav-link" href="{{ path('app_culture_list') }}">Cultures</a>
            <a class="nav-link" href="{{ path('app_parcelle_list') }}">Parcelles</a>
            <a class="nav-link" href="{{ path('app_recolte_list') }}">Recoltes</a>
            <a class="nav-link" href="{{ path('app_vente_list') }}">Ventes</a>
            <a class="nav-link" href="{{ path('app_produit_list') }}">Produits</a>
            <a class="nav-link" href="{{ path('app_mouvement_stock_list') }}">Mouvements de Stock</a>
            <a class="nav-link" href="{{ path('front_systeme_irrigation_index') }}">Irrigation</a>
            {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
                <a class="nav-link" href="{{ path('app_admin_dashboard') }}">Administration</a>
            {% endif %}
            {% if app.user %}
                {% set userPhoto = app.user.photoPath %}
                {% if userPhoto %}
                    {% set userPhotoSrc = userPhoto starts with 'http' ? userPhoto : vich_uploader_asset(app.user, 'photoFile') %}
                {% endif %}
                <a class="nav-link front-avatar-link" href="{{ path('app_profile_edit') }}" title="Modifier le profil">
                    {% if userPhoto %}
                        <img src="{{ userPhotoSrc }}" alt="Profil" class="front-avatar-img">
                    {% else %}
                        <span class="front-avatar-fallback">{{ app.user.prenomUser|default('U')|slice(0, 1)|upper }}</span>
                    {% endif %}
                    <span class="d-none d-md-inline">Profil</span>
                </a>
                <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container pb-4">
    <section class="front-hero">
        <div class="front-hero-inner">
            <div>
                <p class="front-kicker">Agriculture Durable</p>
                <h1>Growing smarter fields with AgriGo </h1>
            </div>
            <div class="front-badges">
                <span class="front-badge">Data-Driven Crops</span>
                <span class="front-badge">Healthy Parcels</span>
                <span class="front-badge">Risk Visibility</span>
            </div>
        </div>
    </section>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <section class="front-shell">
        {% block content %}{% endblock %}
    </section>
</main>

{% if app.user %}
<!-- AI Chatbot UI -->
<div id="ai-chat-bubble" class="ai-chat-bubble" title="Assistant AgriGo">
    <i class="fas fa-robot"></i>
</div>

<div id="ai-chat-window" class="ai-chat-window d-none">
    <div class="ai-chat-header">
        <div class="d-flex align-items-center gap-2">
            <div class="ai-avatar">
                <i class="fas fa-robot"></i>
            </div>
            <div>
                <h6 class="m-0">Assistant AgriGo</h6>
                <small class="text-white-50">En ligne</small>
            </div>
        </div>
        <button id="close-chat" class="btn-close btn-close-white"></button>
    </div>
    <div id="ai-chat-messages" class="ai-chat-body">
        <div class="ai-message bot">
            Bonjour {{ app.user.prenomUser }} ! Je suis votre assistant AgriGo. Comment puis-je vous aider aujourd'hui ?
        </div>
    </div>
    <div class="ai-chat-footer">
        <form id="ai-chat-form" class="d-flex gap-2">
            <input type="text" id="ai-chat-input" class="form-control" placeholder="Posez votre question..." autocomplete="off">
            <button type="submit" class="btn btn-primary btn-send">
                <i class="fas fa-paper-plane"></i>
            </button>
        </form>
    </div>
</div>

<style>
    .ai-chat-bubble {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--front-forest) 0%, var(--front-olive) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(42, 90, 62, 0.3);
        z-index: 9999;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .ai-chat-bubble:hover {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 15px 30px rgba(42, 90, 62, 0.4);
    }
    .ai-chat-window {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 380px;
        height: 500px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(42, 90, 62, 0.2);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
        z-index: 9998;
        overflow: hidden;
        animation: chatSlideIn 0.4s ease-out;
    }
    @keyframes chatSlideIn {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .ai-chat-header {
        background: var(--front-forest);
        color: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ai-avatar {
        width: 35px;
        height: 35px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }
    .ai-chat-body {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 15px;
        background: url('https://www.transparenttextures.com/patterns/pinstriped-suit.png');
    }
    .ai-message {
        padding: 10px 15px;
        border-radius: 15px;
        max-width: 85%;
        font-size: 0.95rem;
        line-height: 1.4;
        position: relative;
        white-space: pre-wrap; /* Support for newlines from AI */
        word-wrap: break-word;
    }
    .ai-message.bot {
        align-self: flex-start;
        background: white;
        color: var(--front-ink);
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .ai-message.user {
        align-self: flex-end;
        background: var(--front-forest);
        color: white;
        border-bottom-right-radius: 2px;
    }
    .ai-chat-footer {
        padding: 15px;
        background: white;
        border-top: 1px solid #eee;
    }
    .btn-send {
        background: var(--front-forest) !important;
        border: none !important;
    }
    .typing-indicator {
        font-style: italic;
        font-size: 0.8rem;
        color: var(--front-muted);
        margin-top: -10px;
        display: none;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const bubble = document.getElementById('ai-chat-bubble');
    const window = document.getElementById('ai-chat-window');
    const closeBtn = document.getElementById('close-chat');
    const chatForm = document.getElementById('ai-chat-form');
    const chatInput = document.getElementById('ai-chat-input');
    const chatMessages = document.getElementById('ai-chat-messages');

    bubble.addEventListener('click', () => {
        window.classList.toggle('d-none');
        if (!window.classList.contains('d-none')) {
            chatInput.focus();
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
    });

    closeBtn.addEventListener('click', () => {
        window.classList.add('d-none');
    });

    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const message = chatInput.value.trim();
        if (!message) return;

        // Add user message
        addMessage(message, 'user');
        chatInput.value = '';

        // Add typing indicator
        const typingId = 'typing-' + Date.now();
        const typingDiv = document.createElement('div');
        typingDiv.id = typingId;
        typingDiv.className = 'ai-message bot typing-indicator';
        typingDiv.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> L\'IA réfléchit...';
        typingDiv.style.display = 'block';
        chatMessages.appendChild(typingDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        try {
            const response = await fetch('{{ path("api_ai_chat") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            });
            const data = await response.json();
            
            // Remove typing indicator
            document.getElementById(typingId).remove();

            if (data.response) {
                addMessage(data.response, 'bot');
            } else {
                addMessage("Désolé, une erreur est survenue.", 'bot');
            }
        } catch (error) {
            document.getElementById(typingId).remove();
            addMessage("Erreur de connexion.", 'bot');
        }
    });

    function addMessage(text, side) {
        const div = document.createElement('div');
        div.className = `ai-message ${side}`;
        div.innerText = text;
        chatMessages.appendChild(div);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }
});
</script>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{{ importmap('app') }}
{% include 'components/_voice_assistant.html.twig' %}
<style>
    /* Prevent overlap with the chatbot */
    .voice-assistant-container {
        right: auto !important;
        left: 30px !important;
    }
    .voice-panel {
        right: auto !important;
        left: 0 !important;
    }
</style>
{% block javascripts %}{% endblock %}
</body>
</html>
