<!-- GOOGLE SUGGESTIONS STYLES & SCRIPT -->
<style>
/* Google Suggestions Section */
.google-suggestions-section {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
    animation: slideInUp 0.6s ease-out;
}

.suggestions-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.suggestions-title {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.title-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: linear-gradient(135deg, #4285f4, #34a853);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 8px 20px rgba(66, 133, 244, 0.2);
}

.title-content h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1f2937;
}

.title-content p {
    margin: 0.25rem 0 0 0;
    color: #64748b;
    font-size: 0.875rem;
}

.suggestions-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #4285f4, #1967d2);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(66, 133, 244, 0.3);
}

.suggestions-badge i {
    font-size: 1rem;
}

/* Suggestions Grid */
.suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.suggestion-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.suggestion-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(66, 133, 244, 0.05), transparent);
    transition: left 0.6s ease;
}

.suggestion-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
}

.suggestion-card:hover::before {
    left: 100%;
}

.suggestion-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    background: linear-gradient(135deg, #4285f4, #34a853);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
}

.suggestion-content {
    flex: 1;
}

.suggestion-content h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.3;
}

.suggestion-content p {
    margin: 0;
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.4;
}

.suggestion-action {
    flex-shrink: 0;
}

.btn-suggestion {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: none;
    background: linear-gradient(135deg, #4285f4, #1967d2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1rem;
}

.btn-suggestion:hover {
    background: linear-gradient(135deg, #1967d2, #1557b0);
    transform: scale(1.1);
}

/* Responsive Design */
@media (max-width: 768px) {
    .google-suggestions-section {
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    
    .suggestions-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    .suggestions-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .suggestion-card {
        padding: 1rem;
    }
    
    .suggestion-icon {
        width: 40px;
        height: 40px;
        font-size: 1rem;
    }
    
    .btn-suggestion {
        width: 35px;
        height: 35px;
    }
}

/* Animation */
@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.suggestion-card {
    animation: slideInUp 0.5s ease-out;
}

.suggestion-card:nth-child(2) {
    animation-delay: 0.1s;
}

.suggestion-card:nth-child(3) {
    animation-delay: 0.2s;
}

.suggestion-card:nth-child(4) {
    animation-delay: 0.3s;
}

.suggestion-card:nth-child(5) {
    animation-delay: 0.4s;
}
</style>

<script>
// Handle Google Suggestions
function handleSuggestion(suggestion) {
    console.log('Suggestion clicked:', suggestion);
    
    // Track suggestion click
    trackSuggestionClick(suggestion);
    
    // Navigate based on suggestion
    switch(suggestion) {
        case 'Aller aux cultures':
            window.location.href = '{{ path("admin_culture_index") }}';
            break;
        case 'Créer une tâche':
            // Show task creation modal or navigate to task page
            showTaskCreationModal();
            break;
        case 'Statistiques de ma ferme':
            window.location.href = '{{ path("app_admin_dashboard") }}';
            break;
        case 'Météo aujourd\'hui':
            showWeatherModal();
            break;
        case 'Aide':
            showHelpModal();
            break;
        default:
            console.log('Unknown suggestion:', suggestion);
    }
}

// Track suggestion click (analytics)
function trackSuggestionClick(suggestion) {
    // Log analytics data locally (could be sent to real analytics service later)
    console.log('Suggestion tracked:', {
        suggestion: suggestion,
        timestamp: new Date().toISOString(),
        user_agent: navigator.userAgent
    });
    
    // Optional: Send to analytics service if available
    // fetch('/api/analytics/track', {
    //     method: 'POST',
    //     headers: {
    //         'Content-Type': 'application/json',
    //         'X-Requested-With': 'XMLHttpRequest'
    //     },
    //     body: JSON.stringify({
    //         suggestion: suggestion,
    //         timestamp: new Date().toISOString(),
    //         user_agent: navigator.userAgent
    //     })
    // }).catch(error => {
    //     console.log('Analytics tracking failed:', error);
    // });
}

// Show task creation modal
function showTaskCreationModal() {
    const modal = document.createElement('div');
    modal.className = 'modal fade';
    modal.innerHTML = `
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-square me-2"></i>
                        Créer une nouvelle tâche
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="taskForm">
                        <div class="mb-3">
                            <label class="form-label">Titre de la tâche</label>
                            <input type="text" class="form-control" name="title" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="description" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Priorité</label>
                            <select class="form-select" name="priority">
                                <option value="low">Basse</option>
                                <option value="medium" selected>Moyenne</option>
                                <option value="high">Haute</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date d'échéance</label>
                            <input type="date" class="form-control" name="due_date">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary" onclick="saveTask()">Créer la tâche</button>
                </div>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    const bootstrapModal = new bootstrap.Modal(modal);
    bootstrapModal.show();
    
    modal.addEventListener('hidden.bs.modal', () => {
        document.body.removeChild(modal);
    });
}

// Save task
function saveTask() {
    const form = document.getElementById('taskForm');
    const formData = new FormData(form);
    
