# ==============================
# Symfony Core
# ==============================
APP_ENV=dev
APP_SECRET=CHANGE_ME_GENERATE_NEW_SECRET
APP_SHARE_DIR=var/share

# ==============================
# Routing
# ==============================
DEFAULT_URI=http://localhost
APP_PUBLIC_BASE_URL=

# ==============================
# OpenWeather
# ==============================
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# ==============================
# Agri Data APIs
# ==============================
PERENUAL_API_KEY=YOUR_PERENUAL_API_KEY
KAEGRO_API_BASE_URL=https://api.kaegro.com/v1

# ==============================
# Twilio (SMS)
# ==============================
TWILIO_SID=YOUR_TWILIO_SID
TWILIO_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM=+XXXXXXXXXXX

# ==============================
# Stripe Payments
# ==============================
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx

# ==============================
# OpenAI / AI Services
# ==============================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ==============================
# Database
# ==============================
DATABASE_URL="mysql://root:@127.0.0.1:3306/agri_go_db?serverVersion=10.4.32-MariaDB&charset=utf8mb4"

# ==============================
# Mailer (Gmail SMTP)
# ==============================
MAILER_DSN="smtp://USER:APP_PASSWORD@smtp.gmail.com:587"
MAILER_FROM_ADDRESS="your-email@gmail.com"
MAILER_FORCE_TO=

# ==============================
# Messenger
# ==============================
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ==============================
# Google OAuth
# ==============================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ==============================
# Luxand AI
# ==============================
LUXAND_API_KEY=YOUR_LUXAND_API_KEY